# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=https://api.thefameexchange.com

# ── Internal API key (shared with backend — keep this secret, server-side only
# in an ideal world; here it's used as a request header for the SPA)
VITE_SECRET_KEY=replace_with_your_api_key

# ── Stripe (publishable key is intentionally public — use your live key here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Google Maps (restrict to *.thefameexchange.com in GCP Console)
VITE_GOOGLE_MAPS_KEY=AIza...
